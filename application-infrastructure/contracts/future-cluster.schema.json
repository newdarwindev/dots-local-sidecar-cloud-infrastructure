            "null"
          ],
          "minimum": 0
        },
        "designHeadroomPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        }
      }
    },
    "tokscale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appImage",
        "postgresImage",
        "privateOrigin",
        "gatewayPodLabel",
        "databaseSize"
      ],
      "properties": {
        "appImage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9./_:-]*@sha256:[0-9a-f]{64}$"
        },
        "postgresImage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9./_:-]*@sha256:[0-9a-f]{64}$"
        },
        "privateOrigin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$"
        },
        "gatewayPodLabel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "databaseSize": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[1-9][0-9]*(Gi|Ti)$"
        }
      }
