    "operators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clickhouse"
      ],
      "properties": {
        "clickhouse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidateVersion",
            "candidateCommit",
            "observedVersion",
            "observedCommit",
            "servedApis"
          ],
          "properties": {
            "candidateVersion": {
              "const": "v0.0.8"
            },
            "candidateCommit": {
              "const": "ebcb5b6c7b2031e88671b4281f2b8ae60f6f71fd"
            },
            "observedVersion": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "observedCommit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "^[a-f0-9]{40}$"
            },
            "servedApis": {
              "type": "array",
              "items": {
                "enum": [
                  "clickhouse.com/v1alpha1/ClickHouseCluster",
                  "clickhouse.com/v1alpha1/KeeperCluster"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availableCpuMillicores",
        "availableMemoryMiB",
        "rootFreeGiB",
        "storageFreeGiB",
        "operatorCpuMillicores",
        "operatorMemoryMiB",
        "designHeadroomPercent"
      ],
      "properties": {
        "availableCpuMillicores": {
          "type": [
            "integer",
            "null"
          ],
